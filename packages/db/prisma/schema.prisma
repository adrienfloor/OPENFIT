// Prisma schema for OpenFit
// Each user-owned model has a userId FK to enforce multi-tenancy at the DB layer.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  user
  admin
}

enum Sex {
  male
  female
}

enum WorkoutType {
  strength
  free
  martial_arts
  run
  bike
  swim
  hike
  walk
  other
}

enum MuscleGroup {
  chest
  back
  shoulders
  biceps
  triceps
  forearms
  core
  quads
  hamstrings
  glutes
  calves
  full_body
}

enum Equipment {
  barbell
  dumbbell
  kettlebell
  cable
  machine
  bodyweight
  resistance_band
  other
}

enum MealType {
  breakfast
  lunch
  dinner
  snack
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  passwordHash    String
  name            String
  dateOfBirth     DateTime
  weightKg        Float
  heightCm        Float
  sex             Sex
  role            Role     @default(user)
  // CoachingProfile (goal, experience, sessions/week, equipment, etc.).
  // JSON to avoid migrations every time the coach inputs evolve.
  coachingProfile Json?
  // Daily macro targets ({ kcal, proteinG, carbsG, fatG }). Optional —
  // set via the nutrition settings screen, defaults to BMR-driven suggestion
  // on the client until set.
  macroTargets    Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  refreshTokens    RefreshToken[]
  programs         Program[]
  workoutLogs      WorkoutLog[]
  dailyHealth      DailyHealth[]
  foodAnalyses     FoodAnalysis[]
  foodLogs         FoodLog[]
  insights         Insight[]
}

model RefreshToken {
  id          String   @id @default(cuid())
  hashedToken String   @unique
  userId      String
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Exercise {
  id           String        @id @default(cuid())
  name         String        @unique
  muscleGroups MuscleGroup[]
  equipment    Equipment

  plannedExercises PlannedExercise[]
  exerciseLogs     ExerciseLog[]
}

model Program {
  id     String @id @default(cuid())
  userId String
  name   String

  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  weeks      Week[]
  generation ProgramGeneration?

  @@index([userId])
}

// Stores the raw AI-generated program (with rationales, phase metadata,
// and the prompt inputs) for traceability and future regeneration.
// One per Program; absent for manually-built programs.
model ProgramGeneration {
  id         String   @id @default(cuid())
  programId  String   @unique
  userId     String
  // Raw GeneratedProgram JSON as returned by the LLM (post Zod validation).
  generated  Json
  // Snapshot of the CoachPromptInput used, so we can replay or audit later.
  promptInput Json
  // Model + prompt version for reproducibility.
  model      String
  createdAt  DateTime @default(now())

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Week {
  id         String @id @default(cuid())
  programId  String
  weekNumber Int

  program  Program   @relation(fields: [programId], references: [id], onDelete: Cascade)
  sessions Session[]

  @@unique([programId, weekNumber])
}

model Session {
  id     String @id @default(cuid())
  weekId String
  name   String

  week             Week              @relation(fields: [weekId], references: [id], onDelete: Cascade)
  plannedExercises PlannedExercise[]
  workoutLogs      WorkoutLog[]
}

model PlannedExercise {
  id         String @id @default(cuid())
  sessionId  String
  exerciseId String
  orderIndex Int

  session  Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise Exercise     @relation(fields: [exerciseId], references: [id])
  sets     PlannedSet[]

  @@unique([sessionId, orderIndex])
}

model PlannedSet {
  id                String  @id @default(cuid())
  plannedExerciseId String
  setIndex          Int
  reps              Int
  weight            Float?
  rpe               Float?
  restSeconds       Int

  plannedExercise PlannedExercise @relation(fields: [plannedExerciseId], references: [id], onDelete: Cascade)

  @@unique([plannedExerciseId, setIndex])
}

model WorkoutLog {
  id          String      @id @default(cuid())
  userId      String
  sessionId   String?
  type        WorkoutType @default(strength)
  startedAt   DateTime
  completedAt DateTime?
  caloriesBurned Float?

  // Run-specific fields, null for non-run types.
  distanceMeters       Float?
  durationSeconds      Int?
  avgPaceSecondsPerKm  Float?
  bestPaceSecondsPerKm Float?
  elevationGainMeters  Float?

  // VO₂max estimate from this workout (Uth–Sørensen). Set only when the
  // session passes the qualifying gate (≥10min, avgHR ≥ 0.7·HRmax) — for
  // sustained runs and hard free sessions. Lifting and short jogs leave
  // these null. The Fitness Age service picks the best of the last 28
  // days of estimates.
  vo2maxEstimate    Float?
  vo2maxComputedAt  DateTime?

  // Provenance — where the row came from. "manual" = recorded inside
  // OpenFit; "health_connect" = imported from another writer (Garmin,
  // Strava, etc.) via the HC ExerciseSession bridge.
  source            String  @default("manual")
  // For HC imports, the upstream session UID so re-syncs are idempotent.
  // Postgres allows multiple NULLs in a unique index, so manual rows
  // (externalId = null) all coexist.
  externalId        String?
  // The HC dataOrigin packageName (e.g. "com.garmin.android.apps.connectmobile").
  // Used to label the History row and to break duplicate-writer ties.
  dataOrigin        String?
  // Set on a manual log when an overlapping HC import was absorbed into
  // it instead of being inserted. Prevents the next sync from
  // re-creating the duplicate.
  linkedExternalId  String?
  // For HC imports, the route-availability state captured at import
  // time. "DATA" = route already in gpsPoints; "CONSENT_REQUIRED" = the
  // writer (Zepp etc.) shared the route but Google gates it behind a
  // per-session consent prompt; "NO_DATA" = the writer (Garmin, Coros)
  // doesn't share routes via HC at all. Drives the detail-screen
  // affordance (load button vs static "not shared" line).
  hcRouteType       String?

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  session          Session?          @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  heartRateSamples HeartRateSample[]
  exerciseLogs     ExerciseLog[]
  gpsPoints        GPSPoint[]

  @@unique([userId, externalId])
  @@index([userId])
  @@index([userId, startedAt])
  @@index([userId, type])
}

model ExerciseLog {
  id           String @id @default(cuid())
  workoutLogId String
  exerciseId   String

  workoutLog    WorkoutLog     @relation(fields: [workoutLogId], references: [id], onDelete: Cascade)
  exercise      Exercise       @relation(fields: [exerciseId], references: [id])
  completedSets CompletedSet[]

  @@index([workoutLogId])
}

model CompletedSet {
  id                    String  @id @default(cuid())
  exerciseLogId         String
  setIndex              Int
  reps                  Int
  weight                Float
  rpe                   Float?
  restTaken             Int
  heartRateAtCompletion Int?

  exerciseLog ExerciseLog @relation(fields: [exerciseLogId], references: [id], onDelete: Cascade)

  @@unique([exerciseLogId, setIndex])
}

model GPSPoint {
  id             String   @id @default(cuid())
  workoutLogId   String
  lat            Float
  lng            Float
  altitudeMeters Float
  timestamp      DateTime
  speedMps       Float

  workoutLog WorkoutLog @relation(fields: [workoutLogId], references: [id], onDelete: Cascade)

  @@index([workoutLogId])
}

model HeartRateSample {
  id           String   @id @default(cuid())
  timestamp    DateTime
  bpm          Int
  zone         String
  workoutLogId String

  workoutLog WorkoutLog @relation(fields: [workoutLogId], references: [id], onDelete: Cascade)

  @@index([workoutLogId])
}

// ──────────────────────────────────────────────────────────────────────────
// Nutrition — AI photo analysis + confirmed food logs.
//
// The vision model returns a structured FoodAnalysis. Items are stored as JSON
// on the analysis (and again on the FoodLog when the user confirms) — they're
// arbitrary user-edited content, not relational entities, so a JSON column is
// the right granularity.
// ──────────────────────────────────────────────────────────────────────────

model FoodAnalysis {
  id        String   @id @default(cuid())
  userId    String
  photoUrl  String
  // VisionAnalysisOutput JSON — { items: [...], notes? }
  items     Json
  // MacroTotals JSON — { kcal, proteinG, carbsG, fatG }
  totals    Json
  model     String
  notes     String?
  createdAt DateTime @default(now())

  // Set when the user confirms this analysis as a FoodLog. Null while the
  // analysis is unresolved — useful for debugging accuracy and for offering
  // "resume" UX if the user backgrounds the app mid-flow.
  foodLogId String?  @unique
  foodLog   FoodLog? @relation(fields: [foodLogId], references: [id], onDelete: SetNull)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
}

model FoodLog {
  id         String    @id @default(cuid())
  userId     String
  photoUrl   String?
  // FoodItem[] JSON — confirmed/edited by the user.
  items      Json
  totals     Json
  mealType   MealType?
  loggedAt   DateTime
  createdAt  DateTime  @default(now())

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Backref of the FoodAnalysis whose foodLogId points at this row, if any.
  analysis FoodAnalysis?

  @@index([userId])
  @@index([userId, loggedAt])
}

// AI-generated Today-tab insight rows. Cached per
// (userId, focus, dateBucket, lastEventStamp) so the same key is reused
// across refreshes and the row is regenerated only when the calendar
// day rolls over OR a downstream input (workout / health) advances the
// event stamp. Multiple rows per (user, focus, day) are expected over
// the day's lifetime; a janitor can prune dateBucket < today−30d.
model Insight {
  id              String   @id @default(cuid())
  userId          String
  focus           String   // InsightFocus zod enum
  // Local-day bucket (UTC) the insight was generated for, formatted as
  // YYYY-MM-DD. Stored as a string so a Postgres unique index plays
  // nicely with the rolling window — no @db.Date conversion edge cases.
  dateBucket      String
  // ISO timestamp of the latest event feeding this insight
  // (max(WorkoutLog.completedAt, DailyHealth.updatedAt)). When inputs
  // shift, this advances and creates a fresh cache row.
  lastEventStamp  DateTime
  // Snapshot of the InsightPromptInput used — useful for debugging and
  // for "based on" transparency in the UI.
  promptInput     Json
  // Headline / body / inputs[] / window — the InsightOutput payload.
  output          Json
  model           String
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, focus, dateBucket, lastEventStamp])
  @@index([userId])
  @@index([userId, dateBucket])
}

model DailyHealth {
  id                   String   @id @default(cuid())
  date                 DateTime @db.Date
  userId               String
  steps                Int?
  caloriesActive       Float?
  caloriesTotal        Float?
  heartRateResting     Int?
  hrvRmssd             Float?
  sleepDurationMinutes Int?
  sleepScore           Float?
  recoveryScore        Float?
  effortScore          Float?
  effortEarnedMinutes  Float?
  // Banister TRIMP for the day. Persisted so the PMC layer (CTL/ATL/TSB)
  // can read a 42-day history without re-fetching all HR samples each refresh.
  dailyTrimp           Float?
  // Tracks the most recent write so the AI insight cache can invalidate
  // when a Health Connect bulk sync fills in last night's sleep / HRV.
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}
