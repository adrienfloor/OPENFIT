// Prisma schema for OpenFit
// Each user-owned model has a userId FK to enforce multi-tenancy at the DB layer.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  user
  admin
}

enum Sex {
  male
  female
}

enum WorkoutType {
  strength
  free
  run
}

enum MuscleGroup {
  chest
  back
  shoulders
  biceps
  triceps
  forearms
  core
  quads
  hamstrings
  glutes
  calves
  full_body
}

enum Equipment {
  barbell
  dumbbell
  kettlebell
  cable
  machine
  bodyweight
  resistance_band
  other
}

enum MealType {
  breakfast
  lunch
  dinner
  snack
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  passwordHash    String
  name            String
  dateOfBirth     DateTime
  weightKg        Float
  heightCm        Float
  sex             Sex
  role            Role     @default(user)
  // CoachingProfile (goal, experience, sessions/week, equipment, etc.).
  // JSON to avoid migrations every time the coach inputs evolve.
  coachingProfile Json?
  // Daily macro targets ({ kcal, proteinG, carbsG, fatG }). Optional —
  // set via the nutrition settings screen, defaults to BMR-driven suggestion
  // on the client until set.
  macroTargets    Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  refreshTokens    RefreshToken[]
  programs         Program[]
  workoutLogs      WorkoutLog[]
  dailyHealth      DailyHealth[]
  foodAnalyses     FoodAnalysis[]
  foodLogs         FoodLog[]
}

model RefreshToken {
  id          String   @id @default(cuid())
  hashedToken String   @unique
  userId      String
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Exercise {
  id           String        @id @default(cuid())
  name         String        @unique
  muscleGroups MuscleGroup[]
  equipment    Equipment

  plannedExercises PlannedExercise[]
  exerciseLogs     ExerciseLog[]
}

model Program {
  id     String @id @default(cuid())
  userId String
  name   String

  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  weeks      Week[]
  generation ProgramGeneration?

  @@index([userId])
}

// Stores the raw AI-generated program (with rationales, phase metadata,
// and the prompt inputs) for traceability and future regeneration.
// One per Program; absent for manually-built programs.
model ProgramGeneration {
  id         String   @id @default(cuid())
  programId  String   @unique
  userId     String
  // Raw GeneratedProgram JSON as returned by the LLM (post Zod validation).
  generated  Json
  // Snapshot of the CoachPromptInput used, so we can replay or audit later.
  promptInput Json
  // Model + prompt version for reproducibility.
  model      String
  createdAt  DateTime @default(now())

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Week {
  id         String @id @default(cuid())
  programId  String
  weekNumber Int

  program  Program   @relation(fields: [programId], references: [id], onDelete: Cascade)
  sessions Session[]

  @@unique([programId, weekNumber])
}

model Session {
  id     String @id @default(cuid())
  weekId String
  name   String

  week             Week              @relation(fields: [weekId], references: [id], onDelete: Cascade)
  plannedExercises PlannedExercise[]
  workoutLogs      WorkoutLog[]
}

model PlannedExercise {
  id         String @id @default(cuid())
  sessionId  String
  exerciseId String
  orderIndex Int

  session  Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise Exercise     @relation(fields: [exerciseId], references: [id])
  sets     PlannedSet[]

  @@unique([sessionId, orderIndex])
}

model PlannedSet {
  id                String  @id @default(cuid())
  plannedExerciseId String
  setIndex          Int
  reps              Int
  weight            Float?
  rpe               Float?
  restSeconds       Int

  plannedExercise PlannedExercise @relation(fields: [plannedExerciseId], references: [id], onDelete: Cascade)

  @@unique([plannedExerciseId, setIndex])
}

model WorkoutLog {
  id          String      @id @default(cuid())
  userId      String
  sessionId   String?
  type        WorkoutType @default(strength)
  startedAt   DateTime
  completedAt DateTime?
  caloriesBurned Float?

  // Run-specific fields, null for non-run types.
  distanceMeters       Float?
  durationSeconds      Int?
  avgPaceSecondsPerKm  Float?
  bestPaceSecondsPerKm Float?
  elevationGainMeters  Float?

  // VO₂max estimate from this workout (Uth–Sørensen). Set only when the
  // session passes the qualifying gate (≥10min, avgHR ≥ 0.7·HRmax) — for
  // sustained runs and hard free sessions. Lifting and short jogs leave
  // these null. The Fitness Age service picks the best of the last 28
  // days of estimates.
  vo2maxEstimate    Float?
  vo2maxComputedAt  DateTime?

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  session          Session?          @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  heartRateSamples HeartRateSample[]
  exerciseLogs     ExerciseLog[]
  gpsPoints        GPSPoint[]

  @@index([userId])
  @@index([userId, startedAt])
  @@index([userId, type])
}

model ExerciseLog {
  id           String @id @default(cuid())
  workoutLogId String
  exerciseId   String

  workoutLog    WorkoutLog     @relation(fields: [workoutLogId], references: [id], onDelete: Cascade)
  exercise      Exercise       @relation(fields: [exerciseId], references: [id])
  completedSets CompletedSet[]

  @@index([workoutLogId])
}

model CompletedSet {
  id                    String  @id @default(cuid())
  exerciseLogId         String
  setIndex              Int
  reps                  Int
  weight                Float
  rpe                   Float?
  restTaken             Int
  heartRateAtCompletion Int?

  exerciseLog ExerciseLog @relation(fields: [exerciseLogId], references: [id], onDelete: Cascade)

  @@unique([exerciseLogId, setIndex])
}

model GPSPoint {
  id             String   @id @default(cuid())
  workoutLogId   String
  lat            Float
  lng            Float
  altitudeMeters Float
  timestamp      DateTime
  speedMps       Float

  workoutLog WorkoutLog @relation(fields: [workoutLogId], references: [id], onDelete: Cascade)

  @@index([workoutLogId])
}

model HeartRateSample {
  id           String   @id @default(cuid())
  timestamp    DateTime
  bpm          Int
  zone         String
  workoutLogId String

  workoutLog WorkoutLog @relation(fields: [workoutLogId], references: [id], onDelete: Cascade)

  @@index([workoutLogId])
}

// ──────────────────────────────────────────────────────────────────────────
// Nutrition — AI photo analysis + confirmed food logs.
//
// The vision model returns a structured FoodAnalysis. Items are stored as JSON
// on the analysis (and again on the FoodLog when the user confirms) — they're
// arbitrary user-edited content, not relational entities, so a JSON column is
// the right granularity.
// ──────────────────────────────────────────────────────────────────────────

model FoodAnalysis {
  id        String   @id @default(cuid())
  userId    String
  photoUrl  String
  // VisionAnalysisOutput JSON — { items: [...], notes? }
  items     Json
  // MacroTotals JSON — { kcal, proteinG, carbsG, fatG }
  totals    Json
  model     String
  notes     String?
  createdAt DateTime @default(now())

  // Set when the user confirms this analysis as a FoodLog. Null while the
  // analysis is unresolved — useful for debugging accuracy and for offering
  // "resume" UX if the user backgrounds the app mid-flow.
  foodLogId String?  @unique
  foodLog   FoodLog? @relation(fields: [foodLogId], references: [id], onDelete: SetNull)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
}

model FoodLog {
  id         String    @id @default(cuid())
  userId     String
  photoUrl   String?
  // FoodItem[] JSON — confirmed/edited by the user.
  items      Json
  totals     Json
  mealType   MealType?
  loggedAt   DateTime
  createdAt  DateTime  @default(now())

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Backref of the FoodAnalysis whose foodLogId points at this row, if any.
  analysis FoodAnalysis?

  @@index([userId])
  @@index([userId, loggedAt])
}

model DailyHealth {
  id                   String   @id @default(cuid())
  date                 DateTime @db.Date
  userId               String
  steps                Int?
  caloriesActive       Float?
  caloriesTotal        Float?
  heartRateResting     Int?
  hrvRmssd             Float?
  sleepDurationMinutes Int?
  sleepScore           Float?
  recoveryScore        Float?
  effortScore          Float?
  effortEarnedMinutes  Float?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}
